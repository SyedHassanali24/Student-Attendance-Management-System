rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    // Admin access is tied to the authenticated account, not to a fragile
    // document-id assumption. The UID check remains the primary path; the
    // verified admin email is a controlled fallback for the existing admin
    // record whose document ID was created differently.
    function admin() {
      return signedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'admin@sirsyed.com'
      );
    }

    function ownStudent() { return signedIn() && resource.data.uid == request.auth.uid; }
    function ownAttendance(r) { return signedIn() && r.data.studentId + '@students.sshacms.local' == request.auth.token.email; }

    match /admins/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || request.auth.token.email == resource.data.email);
      allow write: if false;
    }

    match /settings/publicStats { allow get: if true; allow write: if admin(); }

    match /students/{studentId} {
      allow get: if admin() || ownStudent();
      allow list: if admin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create, update, delete: if admin();
    }

    // Admin-only credential status vault. Never stores the actual password.
    match /studentCredentials/{studentDocId} {
      allow read, create, update, delete: if admin();
    }

    match /attendance/{id} { allow read: if admin() || ownAttendance(resource); allow create, update, delete: if admin(); }
    match /fees/{id} { allow read: if admin() || ownAttendance(resource); allow create, update, delete: if admin(); }
    match /results/{id} { allow read: if admin() || ownAttendance(resource); allow create, update, delete: if admin(); }
    match /announcements/{id} { allow read: if admin() || (signedIn() && resource.data.published == true); allow create, update, delete: if admin(); }
    match /materials/{id} { allow read: if admin() || (signedIn() && resource.data.published == true && request.auth.uid in resource.data.studentUids); allow create: if admin() && request.resource.data.createdBy == request.auth.uid && request.resource.data.published == false; allow update: if admin() && resource.data.createdBy == request.auth.uid; allow delete: if admin(); }

    match /{document=**} { allow read, write: if false; }
  }
}
