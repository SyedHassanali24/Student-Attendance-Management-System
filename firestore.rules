rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function ownStudent() { return signedIn() && resource.data.uid == request.auth.uid; }
    function ownStudentById(studentDocId) { return signedIn() && get(/databases/$(database)/documents/students/$(studentDocId)).data.uid == request.auth.uid; }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /settings/publicStats {
      allow get: if true;
      allow write: if admin();
    }

    match /students/{studentId} {
      allow get: if admin() || ownStudent();
      allow list: if admin();
      allow create, update, delete: if admin();
    }

    match /attendance/{id} {
      allow read: if admin() || (resource.data.studentDocId is string && ownStudentById(resource.data.studentDocId));
      allow create, update, delete: if admin();
    }

    match /fees/{id} {
      allow read: if admin() || (resource.data.studentDocId is string && ownStudentById(resource.data.studentDocId));
      allow create, update, delete: if admin();
    }

    match /results/{id} {
      allow read: if admin() || (resource.data.studentDocId is string && ownStudentById(resource.data.studentDocId));
      allow create, update, delete: if admin();
    }

    match /announcements/{id} {
      allow read: if admin() || (signedIn() && resource.data.published == true);
      allow create, update, delete: if admin();
    }

    match /materials/{id} {
      allow read: if admin() || (
        signedIn() && resource.data.published == true &&
        exists(/databases/$(database)/documents/students/$(request.auth.token.studentDocId)) &&
        resource.data.course == get(/databases/$(database)/documents/students/$(request.auth.token.studentDocId)).data.course &&
        resource.data.batch == get(/databases/$(database)/documents/students/$(request.auth.token.studentDocId)).data.batch
      );
      allow create, update, delete: if admin();
    }

    match /{document=**} { allow read, write: if false; }
  }
}
