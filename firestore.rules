rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function ownStudent() { return signedIn() && resource.data.uid == request.auth.uid; }
    function ownAttendance(r) { return signedIn() && r.data.studentId + '@students.sshacms.local' == request.auth.token.email; }

    match /admins/{uid} { allow read: if signedIn() && request.auth.uid == uid; allow write: if false; }
    match /settings/publicStats { allow get: if true; allow write: if admin(); }
    match /students/{studentId} {
      allow get: if admin() || ownStudent();
      allow list: if admin() || (signedIn() && resource.data.uid == request.auth.uid && resource.data.loginEnabled == true);
      allow create, update, delete: if admin();
    }
    match /attendance/{id} { allow read: if admin() || ownAttendance(resource); allow create, update, delete: if admin(); }
    match /fees/{id} { allow read: if admin() || ownAttendance(resource); allow create, update, delete: if admin(); }
    match /results/{id} { allow read: if admin() || ownAttendance(resource); allow create, update, delete: if admin(); }
    match /announcements/{id} { allow read: if admin() || (signedIn() && resource.data.published == true); allow create, update, delete: if admin(); }
    match /materials/{id} {
      allow read: if admin() || (signedIn() && resource.data.published == true && request.auth.uid in resource.data.studentUids);
      allow create: if admin() && request.resource.data.createdBy == request.auth.uid && request.resource.data.published == false;
      allow update: if admin() && resource.data.createdBy == request.auth.uid;
      allow delete: if admin();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
